# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/httpmaker"

# AI (only the deterministic mock provider is supported in this milestone)
HTTPMAKER_AI_PROVIDER="mock"

# Auth.js / GitHub OAuth
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Server-side image storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Development-only global GitHub App integration. Keep false for multi-user deployments.
HTTPMAKER_ENABLE_GLOBAL_GITHUB_APP="false"
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_APP_PRIVATE_KEY=""
# Alternative to GITHUB_APP_PRIVATE_KEY for trusted local development only:
GITHUB_APP_PRIVATE_KEY_PATH=""
