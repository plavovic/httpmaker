# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/httpmaker"

# AI (only the deterministic mock provider is supported in this milestone)
HTTPMAKER_AI_PROVIDER="mock"

# Canonical origin. Production values must be the same stable HTTPS origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / GitHub OAuth
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Google JavaScript origins: http://localhost:3000 and https://YOUR_PRODUCTION_DOMAIN
# Google redirects: http://localhost:3000/api/auth/callback/google
# and https://YOUR_PRODUCTION_DOMAIN/api/auth/callback/google
# Production must use the canonical HTTPS origin. GitHub callback:
# https://your-domain.example/api/auth/callback/github
AUTH_URL="http://localhost:3000"

# Server-side image storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Per-user GitHub App installations
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""
# GITHUB_APP_PRIVATE_KEY_PATH is supported for trusted local development only,
# never as a Vercel secret mechanism.
GITHUB_APP_STATE_SECRET=""
GITHUB_APP_WEBHOOK_SECRET=""

# Distributed rate limiting (Upstash-compatible REST endpoint). Configure this
# explicit pair, or use the KV_REST_API_* pair supplied by Vercel's integration.
RATE_LIMIT_REST_URL=""
RATE_LIMIT_REST_TOKEN=""
# Vercel-managed alternative; no manual RATE_LIMIT_* aliases are needed.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# KV_REST_API_READ_ONLY_TOKEN is intentionally never accepted for rate limiting.
